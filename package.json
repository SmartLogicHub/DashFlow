{
  "name": "dashflow",
  "version": "0.3.1",
  "description": "A focused personal work OS for Obsidian with studio-style Today, Inbox, Projects, Calendar, Habits, Review, search and optional AI planning.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "node tests/run-layout-tests.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "personal-os", "productivity", "tasks", "inbox", "projects", "habits", "calendar", "review", "search", "ai-planning", "dashboard", "templates", "mobile", "studio-ui"],
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
