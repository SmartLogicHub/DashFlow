  },
  "keywords": ["obsidian", "personal-os", "personal-dashboard", "productivity", "visual-filter", "data-filter", "notes", "frontmatter", "ai-news", "rss", "quick-capture", "daily-notes", "context-switcher", "tasks", "projects", "habits", "daily-progress", "calendar", "review", "ai", "dashboard", "mobile"],
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
