    "quick-capture",
    "daily-notes",
    "context-switcher",
    "tasks",
    "projects",
    "habits",
    "daily-progress",
    "calendar",
    "review",
    "ai",
    "dashboard",
    "mobile"
  ],
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "playwright-core": "1.62.1",
    "typescript": "^5.8.3"
  }
